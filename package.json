{
  "name": "deepsea",
  "version": "0.1.0",
  "private": true,
  "description": "深鲸 — 沉浸式 DeepSeek 客户端（Android / Windows）",
  "author": "elyoncat",
  "license": "MIT",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-es-compat.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "preview": "vite preview",
    "build:main": "node scripts/build-electron.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "build:android": "node scripts/build-android.mjs",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "icons": "python scripts/make-icons.py",
    "check:es": "node scripts/check-es-compat.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "0.147.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.147.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.elyoncat.deepsea",
    "productName": "深鲸",
    "directories": {
      "output": "dist-app",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "artifactName": "DeepSea-${version}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "electron-dist/pow-worker.cjs"
    ]
  },
  "dependencies": {
    "sql.js": "^1.16.0"
  }
}
